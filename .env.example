# Copy to .env.local. Everything here is optional: without a key the app runs
# its rule-based review plus clearly labelled seeded demo results.
# Server-side only. Never prefix with NEXT_PUBLIC_.

# OpenAI (used when set)
OPENAI_API_KEY=
# Any Chat Completions model with structured outputs that your key can access. Check /settings after starting.
OPENAI_MODEL=gpt-5.4-mini

# Google Gemini (used only when OPENAI_API_KEY is empty)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
